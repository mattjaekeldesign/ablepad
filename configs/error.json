    "54": { "label": "", "led": { "idle": { "type": "static", "palette": 5 } }, "action": { "type": "NONE", "params": {} } },
    "55": { "label": "", "led": { "idle": { "type": "static", "palette": 5 } }, "action": { "type": "NONE", "params": {} } },
