    "12": { "label": "Tone B", "led": { "idle": { "type": "static", "palette": 37 }, "pressed": { "type": "static", "palette": 13 } }, "action": { "type": "SEND_MIDI", "params": { "message": "B0 15 7F" } } },
    "13": { "label": "Tone C", "led": { "idle": { "type": "static", "palette": 37 }, "pressed": { "type": "static", "palette": 13 } }, "action": { "type": "SEND_MIDI", "params": { "message": "B0 16 7F" } } },
    "14": { "label": "Tone D", "led": { "idle": { "type": "static", "palette": 37 }, "pressed": { "type": "static", "palette": 13 } }, "action": { "type": "SEND_MIDI", "params": { "message": "B0 17 7F" } } },
    "19": { "label": "PANIC", "led": { "idle": { "type": "static", "palette": 5 }, "pressed": { "type": "static", "palette": 13 } }, "action": { "type": "PANIC_MUTE", "params": {} } },
